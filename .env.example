# Copy to .env.local for local dev. On Vercel/Netlify add the same keys in project Environment Variables.
# NOTE: VITE_* values are bundled into the public site (they appear on the page), but stay out of the git repo.
VITE_EMAIL=you@example.com
VITE_PHONE=+00 000 0000000
VITE_LINKEDIN=https://linkedin.com/in/your-handle
# Full URL of your CV PDF (button is hidden if empty)
VITE_CV_URL=
# Full URL of your photo (falls back to /avatar.svg)
VITE_PHOTO_URL=
